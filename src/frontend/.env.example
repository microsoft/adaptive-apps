# ── Local password auth ──────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
SESSION_SECRET=change-me-in-production

# ── Azure AD / Microsoft Entra ID (optional) ────────────────
# Register an app at https://portal.azure.com → App registrations
#   Platform: Web
#   Redirect URI: http://localhost:3000/auth/oidc/callback
#   Supported account types → pick one:
#     "common"        – work/school + personal Microsoft accounts
#     "organizations" – work/school accounts only
#     "consumers"     – personal Microsoft accounts only
#     "<tenant-id>"   – single tenant
#
# Leave AAD_CLIENT_ID empty to disable Microsoft sign-in.
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_TENANT_ID=common
AAD_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
