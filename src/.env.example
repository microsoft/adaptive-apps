# ── AI Agent Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
# Variable names mirror the CONNECTION_AI_* env vars that Radius injects
# automatically when deploying with `rad deploy`. Using the same names
# keeps docker-compose and Radius deployments consistent.

# Provider: "openai" for OpenAI, "openai" for Azure OpenAI (OpenAI-SDK-compatible),
#           "local" for Kaito / vLLM / Ollama
CONNECTION_AI_PROVIDER=openai

# API key (required for OpenAI / Azure OpenAI; leave empty for Kaito/local)
CONNECTION_AI_SECRETS_APIKEY=sk-your-key-here

# Endpoint override – leave empty to use the default for the provider.
# Examples:
#   OpenAI (default)      : (leave empty)
#   Azure OpenAI          : https://<resource>.openai.azure.com/
#   Kaito (in-cluster)    : http://workspace-trading-advisor.default.svc.cluster.local:80/v1
#   Kaito (port-forward)  : http://localhost:8080/v1
#   Ollama (local)        : http://localhost:11434/v1
CONNECTION_AI_ENDPOINT=

# Model / deployment name
#   OpenAI        : gpt-4o, gpt-4o-mini, …
#   Azure OpenAI  : your deployment name
#   Kaito         : the model name from the Kaito preset (e.g. llama-3.1-8b-instruct)
CONNECTION_AI_MODEL=gpt-4o
